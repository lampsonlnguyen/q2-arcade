#!/bin/sh
# Native menu service runs from RAM so USB storage can unmount the card.
pid=/tmp/q2-arcade
if [ "$1" != --service ]; then
    [ -f "$pid" ] && kill -0 "$(cat "$pid")" 2>/dev/null && exit 0
    dir=$(cd "$(dirname "$0")" && pwd) || exit 1
    cp "$dir/q2-arcade" /tmp/q2-arcade.bin || exit 1
    chmod 755 /tmp/q2-arcade.bin || exit 1
    cp "$0" /tmp/q2-arcade.run || exit 1
    cd /tmp || exit 1
    exec /bin/sh /tmp/q2-arcade.run --service
fi
(
    child=
    cleanup() {
        [ -z "$child" ] || { kill -TERM "$child" 2>/dev/null; wait "$child"; }
        rm -f "$pid" /tmp/q2-arcade.bin /tmp/q2-arcade.run /tmp/q2-arcade.browse.sock
    }
    trap 'cleanup; exit 0' TERM INT
    /tmp/q2-arcade.bin --menu &
    child=$!
    wait "$child"
    child=
    cleanup
) </dev/null >/dev/null 2>&1 &
echo $! > "$pid"
